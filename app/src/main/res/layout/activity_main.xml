<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
                                                   xmlns:app="http://schemas.android.com/apk/res-auto"
                                                   xmlns:tools="http://schemas.android.com/tools"
                                                   android:layout_width="match_parent"
                                                   android:layout_height="match_parent"
                                                   android:padding="16dp"
                                                   tools:context=".MainActivity">

    <TextView
        android:id="@+id/title_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="SSH Tunnel"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/profile_management_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title_text">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Profile: "
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/profile_spinner"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/add_profile_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Add Profile"
            android:src="@android:drawable/ic_menu_add" />

        <ImageButton
            android:id="@+id/delete_profile_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Delete Profile"
            android:src="@android:drawable/ic_menu_delete" />
        </LinearLayout>

        <Switch
            android:id="@+id/tunnel_switch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:checked="false"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="Turn Tunnel On/Off"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/profile_management_layout" />

        <Switch
            android:id="@+id/proxy_only_switch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:checked="true"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="Proxy Only Mode"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tunnel_switch" />

        <LinearLayout
            android:id="@+id/ssh_config_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/proxy_only_switch">

            <EditText
                android:id="@+id/ssh_host_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="SSH Host (e.g., example.com)"
                android:inputType="text"
                android:minHeight="48dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/ssh_user_input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Username (e.g., chrono)"
                    android:inputType="text"
                    android:minHeight="48dp" />

                <EditText
                    android:id="@+id/ssh_port_input"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:hint="Port (8000)"
                    android:inputType="number"
                    android:text="8000"
                    android:minHeight="48dp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/key_path_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Private Key Configuration"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ssh_config_container" />

            <LinearLayout
                android:id="@+id/key_path_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/key_path_label">

                <EditText
                    android:id="@+id/key_path_input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Private Key Path"
                    android:inputType="textUri"
                    android:minHeight="48dp" />

                <ImageButton
                    android:id="@+id/btn_browse_key"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_search"
                    android:contentDescription="Browse File" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/network_config_container"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/key_path_container">

                    <EditText
                        android:id="@+id/upstream_port_input"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Upstream"
                        android:inputType="number"
                        android:text="2080"
                        android:minHeight="48dp" />

                    <EditText
                        android:id="@+id/local_proxy_port_input"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Proxy Port"
                        android:inputType="number"
                        android:text="1080"
                        android:minHeight="48dp" />

                    <EditText
                        android:id="@+id/dns_input"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.5"
                        android:hint="DNS Server"
                        android:inputType="text"
                        android:text="77.88.8.8"
                        android:minHeight="48dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/status_section_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Service Status"
                        android:textSize="18sp"
                        android:textStyle="italic"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/network_config_container" />

                    <TextView
                        android:id="@+id/ssh_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="SSH Tunnel:"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/status_section_title" />

                    <TextView
                        android:id="@+id/ssh_status_indicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="-"
                        android:textSize="18sp"
                        app:layout_constraintBottom_toBottomOf="@id/ssh_label"
                        app:layout_constraintStart_toEndOf="@id/ssh_label"
                        app:layout_constraintTop_toTopOf="@id/ssh_label" />

                    <TextView
                        android:id="@+id/ssh_status_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Stopped"
                        app:layout_constraintBottom_toBottomOf="@id/ssh_label"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/ssh_status_indicator"
                        app:layout_constraintTop_toTopOf="@id/ssh_label" />

                    <TextView
                        android:id="@+id/log_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Console Logs:"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/ssh_label" />

                    <ScrollView
                        android:id="@+id/log_scroll_view"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginTop="4dp"
                        android:background="#1E1E1E"
                        android:padding="8dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/log_label">

                        <TextView
                            android:id="@+id/log_text_view"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="Application initialized.\n"
                            android:textColor="#00FF00"
                            android:textSize="12sp"
                            android:textIsSelectable="true" />
                        </ScrollView>

                    </androidx.constraintlayout.widget.ConstraintLayout>
